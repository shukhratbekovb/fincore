# ---------------------------------------------------------------- зависимости

node_modules/
.pnp
.pnp.*
.yarn/install-state.gz

# --------------------------------------------------------------------- сборка

.next/
out/
build/
dist/

# Файлы кеша сборщиков и линтеров: воспроизводятся из исходников,
# в истории от них только конфликты слияния.
*.tsbuildinfo
.eslintcache
.turbo/

# --------------------------------------------------------------------- Python

# Байт-код и кеши инструментов бэкенда: воспроизводятся из исходников.
# Переключение ветки оставляет их на диске, и без этих правил они всплывают
# в `git status` как неотслеживаемые — так и случилось после этапа 0.
__pycache__/
.mypy_cache/
.ruff_cache/
.pytest_cache/

# ---------------------------------------------------------------------- тесты

coverage/
.nyc_output/

# Покрытие Python: и файл с данными, и собранный из него отчёт.
.coverage
htmlcov/

# Playwright: следы прогонов и его собственный кеш браузеров.
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Playwright MCP складывает сюда снимки страниц и логи консоли каждой проверки.
.playwright-mcp/

# ------------------------------------------------------------------- секреты

# Никаких ключей и токенов в репозитории (см. CONTRIBUTING.md). В гит едет
# только образец с именами переменных, но без значений.
.env*
!.env.example
*.pem
*.p12
*.key

# ---------------------------------------------------------------------- логи

*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------ служебное от ОС

.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------------------------------ редакторы

.idea/
*.swp
*.swo
*~

# Настройки VS Code личные, кроме списка рекомендуемых расширений и общих
# настроек проекта: их как раз полезно передать вместе с репозиторием.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# ------------------------------------------------------------- Claude Code

# Личные разрешения и локальные переопределения. Общая конфигурация проекта
# (.mcp.json, .claude/settings.json) остаётся в репозитории: она описывает,
# чем проект собирается и проверяется.
.claude/settings.local.json

# ------------------------------------------------------------- развёртывание

.vercel

# Осознанно НЕ игнорируется:
#
#   next-env.d.ts   — Next.js генерирует его сам, и шаблон create-next-app
#                     его прячет. Здесь он в гите: без него `npm run typecheck`
#                     на свежем клоне падает до первой сборки, а проект должен
#                     переживать передачу другому человеку без ручных шагов.
#   package-lock.json — фиксирует версии; без него сборка у другого человека
#                     соберётся из других пакетов.
#   .mcp.json       — описывает браузер для проверки вёрстки, часть рабочего
#                     процесса, а не личная настройка.
