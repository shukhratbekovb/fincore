# Local development only. Override these values in backend/.env or the environment.
# Used by the root compose.dev.yml. Keep this password in sync with DATABASE_URL.
FINCORE_POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://fincore:change-me@127.0.0.1:55432/fincore
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
HEALTH_CHECK_TIMEOUT=2
LOG_LEVEL=INFO
API_WORKERS=1

# Shared request limits. Local Redis is started by make redis.
REDIS_URL=redis://127.0.0.1:56379/0
REDIS_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1
REDIS_MAX_CONNECTIONS=20

# Request budgets, shared across API processes. All admitted attempts count.
LOGIN_RATE_LIMIT_IP_PER_MINUTE=30
LOGIN_RATE_LIMIT_USERNAME_PER_MINUTE=10
REGISTER_RATE_LIMIT_IP_PER_HOUR=10
REGISTER_RATE_LIMIT_EMAIL_PER_HOUR=3
RESEND_CONFIRMATION_RATE_LIMIT_IP_PER_HOUR=20
RESEND_CONFIRMATION_RATE_LIMIT_EMAIL_PER_HOUR=3
TRANSFER_RATE_LIMIT_USER_PER_MINUTE=30
TRANSFER_RATE_LIMIT_IP_PER_MINUTE=100

# Generate your own secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET_KEY=<your-random-secret-at-least-32-bytes>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_TTL_MINUTES=30
JWT_ISSUER=fincore
JWT_AUDIENCE=fincore-api

# Optional independent cursor key; otherwise a purpose-specific key is derived from JWT_SECRET_KEY.
# PAGINATION_SECRET_KEY=<your-random-secret-at-least-32-bytes>
SANDBOX_ENABLED=false
TRANSFER_MAX_AMOUNT_MINOR=9223372036854775807
SANDBOX_MAX_AMOUNT_MINOR=9223372036854775807

# ISO 8601 duration: one hour.
VERIFICATION_CONFIRMATION_TTL=PT1H

# ISO 8601 duration: thirty days.
SESSION_TTL=P30D

# ISO 8601 duration: fifteen minutes.
PASSWORD_RESET_TTL=PT15M

# Local Mailpit. Start with `make mailpit`, inspect http://127.0.0.1:8025.
SMTP_BACKEND=local
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURITY=none
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_TIMEOUT=10
FRONTEND_CONFIRMATION_URL=http://localhost:3000/confirm
FRONTEND_PASSWORD_RESET_URL=http://localhost:3000/reset-password
EMAIL_LOCALE=ru

# Production SES SMTP: replace the host/identity and use SES SMTP credentials,
# which differ from AWS API access keys. TLS certificates are always verified.
# SMTP_BACKEND=ses
# SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=<SES-SMTP-username>
# SMTP_PASSWORD=<SES-SMTP-password>
# SMTP_FROM_EMAIL=no-reply@your-verified-domain.com
# FRONTEND_CONFIRMATION_URL=https://your-app.example/confirm
# FRONTEND_PASSWORD_RESET_URL=https://your-app.example/reset-password

OUTBOX_CONCURRENCY=4
OUTBOX_POLL_INTERVAL=1
OUTBOX_LEASE_SECONDS=60
OUTBOX_SEND_TIMEOUT=30
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE=5
OUTBOX_RETRY_CAP=300

# Exact wallet recipient lookup budgets.
RECIPIENT_LOOKUP_RATE_LIMIT_USER_PER_MINUTE=30
RECIPIENT_LOOKUP_RATE_LIMIT_IP_PER_MINUTE=100

# Optional service-data maintenance. Days after terminal state/expiry, except
# idempotency: creation age + expires_at, preserving permanent replay receipts.
CLEANUP_SESSION_RETENTION_DAYS=7
CLEANUP_CHALLENGE_RETENTION_DAYS=7
CLEANUP_OUTBOX_RETENTION_DAYS=30
CLEANUP_IDEMPOTENCY_RETENTION_DAYS=7
CLEANUP_BATCH_SIZE=500
CLEANUP_MAX_BATCHES=20
CLEANUP_INTERVAL_SECONDS=86400
