# Root Docker Compose configuration. This is separate from backend/.env.
# Generate independent values, for example: python3 -c "import secrets; print(secrets.token_hex(32))"
POSTGRES_USER=fincore
POSTGRES_DB=fincore
POSTGRES_PASSWORD=replace-with-a-random-hex-password
# Password must match POSTGRES_PASSWORD; percent-encode URL-sensitive characters.
DATABASE_URL=postgresql+asyncpg://fincore:replace-with-a-random-hex-password@postgres:5432/fincore
JWT_SECRET_KEY=replace-with-an-independent-random-secret-of-at-least-32-bytes
FRONTEND_PORT=3000
# Exact public HTTPS origin; no trailing slash. Configure your Nginx separately.
PUBLIC_APP_ORIGIN=https://example.com
# Independent server-only secret. Nginx overwrites X-FinCore-Proxy-Token with it.
FRONTEND_TRUSTED_PROXY_TOKEN=replace-with-a-separate-random-secret-of-at-least-32-characters
# Dedicated frontend/API network; change all three together if this subnet conflicts.
GATEWAY_SUBNET=172.30.85.0/29
FRONTEND_INTERNAL_IP=172.30.85.2
API_INTERNAL_IP=172.30.85.3
API_WORKERS=1
LOG_LEVEL=INFO
HEALTH_CHECK_TIMEOUT=2

# SES SMTP credentials; these are different from AWS API access keys.
SMTP_BACKEND=ses
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=replace-with-ses-smtp-username
SMTP_PASSWORD=replace-with-ses-smtp-password
SMTP_FROM_EMAIL=no-reply@example.com
FRONTEND_CONFIRMATION_URL=https://example.com/confirm
FRONTEND_PASSWORD_RESET_URL=https://example.com/reset-password
EMAIL_LOCALE=ru

# Local smoke tests: --profile dev, SMTP_BACKEND=local, SMTP_HOST=mailpit,
# SMTP_PORT=1025, SMTP_SECURITY=none. Remove SMTP_USERNAME/PASSWORD locally.
MAILPIT_UI_PORT=8025
SANDBOX_ENABLED=false
TRANSFER_MAX_AMOUNT_MINOR=9223372036854775807
SANDBOX_MAX_AMOUNT_MINOR=9223372036854775807
LOGIN_RATE_LIMIT_IP_PER_MINUTE=30
LOGIN_RATE_LIMIT_USERNAME_PER_MINUTE=10
REGISTER_RATE_LIMIT_IP_PER_HOUR=10
REGISTER_RATE_LIMIT_EMAIL_PER_HOUR=3
RESEND_CONFIRMATION_RATE_LIMIT_IP_PER_HOUR=20
RESEND_CONFIRMATION_RATE_LIMIT_EMAIL_PER_HOUR=3
TRANSFER_RATE_LIMIT_USER_PER_MINUTE=30
TRANSFER_RATE_LIMIT_IP_PER_MINUTE=100

# Exact wallet recipient lookup budgets.
RECIPIENT_LOOKUP_RATE_LIMIT_USER_PER_MINUTE=30
RECIPIENT_LOOKUP_RATE_LIMIT_IP_PER_MINUTE=100

# Maintenance: days AFTER expiry/revocation/completion; idempotency uses creation
# age AND expires_at, archiving permanent receipts before deleting the full row.
CLEANUP_SESSION_RETENTION_DAYS=7
CLEANUP_CHALLENGE_RETENTION_DAYS=7
CLEANUP_OUTBOX_RETENTION_DAYS=30
CLEANUP_IDEMPOTENCY_RETENTION_DAYS=7
CLEANUP_BATCH_SIZE=500
CLEANUP_MAX_BATCHES=20
CLEANUP_INTERVAL_SECONDS=86400
