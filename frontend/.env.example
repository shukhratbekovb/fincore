# Server-only URL; no NEXT_PUBLIC prefix. FastAPI should be running here.
BACKEND_API_URL=http://127.0.0.1:8000

# Local `npm run dev` needs no proxy token or production origin.
# Production Docker reads these server-only values from the ROOT .env instead:
# PUBLIC_APP_ORIGIN=https://wallet.example.com
# FRONTEND_TRUSTED_PROXY_TOKEN=<independent random secret, at least 32 characters>
# Nginx must overwrite X-FinCore-Proxy-Token and X-Real-IP for production requests.
# See ../docs/deployment.md. Never prefix these values with NEXT_PUBLIC_.
